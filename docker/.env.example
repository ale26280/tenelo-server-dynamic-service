# ============================================
# Variables de entorno - Tenelo Dynamic Service
# Copiar a .env y completar con valores reales
# ============================================

# ------------------------------------------
# SERVIDOR
# ------------------------------------------
NODE_ENV=production
SERVER_PORT=44104
TZ=America/Argentina/Buenos_Aires
BASE_URL=https://tenelo.ddns.net

# ------------------------------------------
# BASE DE DATOS - MongoDB
# ------------------------------------------
MONGO_HOST=tenelo.db.ds
MONGO_PORT=27017
MONGO_USER=
MONGO_PASS=

# ------------------------------------------
# AUTENTICACIÓN
# ------------------------------------------
AUTH_URL=https://tenelo.ddns.net/auth/v1/
PL=

# ------------------------------------------
# APIS EXTERNAS - Clima
# ------------------------------------------
WEATHERAPI_KEY=
OPENWEATHERMAP_KEY=

# ------------------------------------------
# API TRANSPORTE PÚBLICO - GCBA
# https://data.buenosaires.gob.ar/dataset/api-transporte-publico
# ------------------------------------------
TRANSPORTE_CLIENT_ID=
TRANSPORTE_CLIENT_SECRET=
TRANSPORTE_API_BASE_URL=https://apitransporte.buenosaires.gob.ar
TRANSPORTE_CRON_ENABLED=false
TRANSPORTE_CRON_SCHEDULE=*/30 * * * * *
TRANSPORTE_MODOS_ENABLED=colectivos,subtes,trenes,ecobici,transito

# ------------------------------------------
# ARCHIVOS
# ------------------------------------------
PATH_UPLOADS=/tmp
# Notes
# ==========================================

# - Increase WORKERS for better concurrency, but watch memory usage
# - Reduce MAX_FILE_SIZE if disk space is limited
# - Adjust FILE_RETENTION_HOURS based on your use case
# - Lower LOG_LEVEL to DEBUG for troubleshooting
